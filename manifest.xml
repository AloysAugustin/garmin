<?xml version="1.0" encoding="UTF-8"?>
<!--
    Tesla Key - a standalone BLE phone-key replacement for Tesla vehicles,
    running directly on a Garmin Instinct 2 (and 2S / 2X).

    The app speaks Tesla's documented Vehicle Command protocol
    (https://github.com/teslamotors/vehicle-command) directly over Bluetooth
    Low Energy, acting as a BLE central that connects to the car's VCSEC
    service. No phone is required once a key has been enrolled.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="TeslaKeyApp"
        id="a1b2c3d4e5f6478090a1b2c3d4e5f601"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.3.0"
        name="@Strings.AppName"
        type="watch-app">

        <!-- Instinct 2 family. These are the products the app is built for. -->
        <iq:products>
            <iq:product id="instinct2"/>
            <iq:product id="instinct2s"/>
            <iq:product id="instinct2x"/>
        </iq:products>

        <!--
            BluetoothLowEnergy: required to scan for and talk to the vehicle.
            Note: the app acts as a BLE *central* (GATT client); the car is the
            peripheral. This is the correct role for Connect IQ BLE.
        -->
        <iq:permissions>
            <iq:uses-permission id="BluetoothLowEnergy"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
